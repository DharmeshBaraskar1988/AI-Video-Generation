# --- Language model (Gemini free tier) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Filled in automatically by setup/pick_gemini_model.py (newest Flash model your key can use)
GEMINI_MODEL=
# Free tier is roughly 10 requests/minute: keep LLM calls batched per scene list, not per sentence
GEMINI_MAX_RPM=8
# Free tier allows ~20 requests/day PER MODEL; when one runs out the next is used
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# --- OpenAI (optional, paid) ---
# LLM_PROVIDER=gemini uses Gemini and switches to OpenAI when all Gemini daily quotas are used up.
# LLM_PROVIDER=openai uses OpenAI for every call.
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Embeddings (local, free) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_DIR=backend/app/store/chroma

# --- Voice (free) ---
TTS_ENGINE=edge
VOICE_EN=en-US-GuyNeural
VOICE_AR=ar-QA-MoazNeural
VOICE_RATE=+0%

# --- Video ---
VIDEO_TARGET_SECONDS=150
MUSIC_TRACK=data/music/calm_corporate.mp3
MUSIC_VOLUME=0.12

# --- Stock data ---
STOCK_SOURCE=yfinance
OANOR_API_KEY=
STOCK_CACHE_SECONDS=60

# --- App ---
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///backend/app/store/dstorify.db
